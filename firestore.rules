rules_version = '2';

// 部署方式：Firebase Console → Firestore Database → 規則，整段貼上取代，按「發佈」。
// 記得把下面 BOOTSTRAP_ADMIN_EMAILS 換成你自己的管理員 Email（要跟 firebase-config.js 裡的一致）。

service cloud.firestore {
  match /databases/{database}/documents {

    function bootstrapAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['trista810729@gmail.com'];
    }

    function isAdmin() {
      return request.auth != null && (
        bootstrapAdmin() ||
        (
          exists(/databases/$(database)/documents/config/admins) &&
          request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails
        )
      );
    }

    function signedIn() {
      return request.auth != null;
    }

    // 事項（問題／許願／SOP／交辦／待辦）：登入（含匿名登入）都可以新增、查看、編輯、刪除、留回饋、按讚。
    // 這跟原型一樣是「內部小團隊互信」的開放權限；若之後想改成「只有管理員能刪除」，
    // 把 delete 那行改成 allow delete: if isAdmin(); 即可。
    match /items/{itemId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    // 分類設定：全員可讀，只有管理員可以新增／改名／排序／刪除分類。
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
